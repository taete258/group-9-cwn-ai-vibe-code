// Data model ตาม spec.md ข้อ 5 (v0.4: ไม่มี User/Order/Admin — เหลือแคตตาล็อกอย่างเดียว)
// เงินทุกช่องเป็นสตางค์ (Int) และราคารวม VAT แล้ว
// CHECK constraint (stock >= 0, quantity > 0) อยู่ใน migration SQL เพราะ Prisma schema ยังเขียนไม่ได้

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Species {
  FOLIAGE
  FLOWERING
  SUCCULENT
  FRUIT
  HERB
}

enum Size {
  S
  M
  L
}

enum CareLevel {
  EASY
  MEDIUM
  HARD
}

enum Room {
  LIVING
  BEDROOM
  OFFICE
  KITCHEN
  ENTRANCE
  BALCONY
}

enum Direction {
  N
  NE
  E
  SE
  S
  SW
  W
  NW
}

enum Benefit {
  WEALTH
  HEALTH
  LOVE
  CAREER
}

model Tree {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  nameTh         String
  nameEn         String
  descriptionTh  String
  descriptionEn  String
  scientificName String? // ชื่อวิทยาศาสตร์ (ว่างได้ → ซ่อนช่องนั้น)
  originTh       String? // แหล่งกำเนิด
  originEn       String?
  species        Species
  size           Size
  careLevel      CareLevel
  lightTh        String
  lightEn        String
  waterTh        String
  waterEn        String
  heightCm       Int?
  potSizeInch    Int?
  petSafe        Boolean
  price          Int // สตางค์ รวม VAT
  stock          Int
  images         String[]
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  fengShui    FengShui[]
  collections CollectionItem[]
}

model FengShui {
  id        Int       @id @default(autoincrement())
  treeId    Int
  room      Room
  direction Direction
  benefit   Benefit
  reasonTh  String
  reasonEn  String

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([room, benefit])
}

model Collection {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  nameTh    String
  nameEn    String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  items CollectionItem[]
}

model CollectionItem {
  collectionId Int
  treeId       Int
  sortOrder    Int @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tree       Tree       @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@id([collectionId, treeId])
}
